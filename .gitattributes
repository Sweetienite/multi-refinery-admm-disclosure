# Enforce LF line endings in the repository.
# This prevents CRLF/LF mix-up when contributors clone on Windows.
* text=auto eol=lf
*.py  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.cff  text eol=lf
*.png  binary
*.jpg  binary
*.pdf  binary

# This supplied, hash-locked figure bundle intentionally preserves the
# producer's CSV bytes (including CRLF) so MANIFEST.sha256 stays meaningful.
manuscript_figures_20260731/data/*.csv -text -eol
