# Enforce LF line endings in the repository.
# This prevents CRLF/LF mix-up when contributors clone on Windows.
* text=auto eol=lf
*.py  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.cff  text eol=lf
*.png  binary
*.jpg  binary
*.pdf  binary
